# Prefer npm run setup, which generates random local database passwords.
POSTGRES_PASSWORD=replace-owner-password
APP_DB_PASSWORD=replace-runtime-password
DATABASE_URL=postgresql://hris_app:replace-runtime-password@localhost:5432/hris
MIGRATION_DATABASE_URL=postgresql://postgres:replace-owner-password@localhost:5432/hris
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
API_PORT=4000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=HRIS <no-reply@hris.local>
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# For real SMTP, set SMTP_USER, SMTP_PASSWORD and SMTP_SECURE=true for implicit TLS.

# npm run setup generates a 32-byte hexadecimal key. Preserve it on upgrade.
# MFA_ENCRYPTION_KEY=
